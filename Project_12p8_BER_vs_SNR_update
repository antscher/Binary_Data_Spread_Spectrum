grid on; xlabel('Normalized frequency (cycles/sample)');
ylabel('Magnitude (dB, normalized)');
title('DSSS spectrum vs M (larger M → wider/flatter)');
legend(arrayfun(@(m) sprintf('DSSS, M=%d', m), Ms_demo, 'UniformOutput', false), ...
       'Location','southwest');
finish_fig('DSSS spectrum for different M');

%% -------- Despreading collapses spectrum --------
[Wrx_dB, fNrx]  = mag_spectrum_dB(rx, Nfft);
[Wde_dB, fNde]  = mag_spectrum_dB(despread, Nfft);
figure;
plot(fNrx, Wrx_dB, 'LineWidth',1); hold on;
plot(fNde, Wde_dB, 'LineWidth',1);
grid on; xlabel('Normalized frequency (cycles/sample)');
ylabel('Magnitude (dB, normalized)');
title('Before vs After Despreading (same PN)');
legend('Received (spread + noise + tone)', 'Despread (collapse near baseband)', ...
       'Location','southwest');
finish_fig('Before vs After Despreading');

