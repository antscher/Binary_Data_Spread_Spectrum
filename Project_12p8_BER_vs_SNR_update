%% -------- PARAMETERS --------
signal_length = 20;        % number of bits for the single-run demo
M  = 1000;                 % chips (samples) per bit for the single-run demo
Pn = 1;                    % uniform-noise power, Pn = a^2/3
A  = 10;                   % sinusoid amplitude for the single-run demo
w0 = 0.17*pi;              % sinusoid rad/sample, 0 < w0 < pi

% PN (LFSR)
init = [1 1 1 1 1 0 1];    % 7-stage seed (non-zero)
taps = [1 4 7];            % feedback taps (1 = leftmost/MSB)

rng(1);                    % reproducibility

% ---- switches ----
RUN_SWEEPS  = true;        % set false to skip all BER sweeps
FAST_SWEEPS = true;        % lighter params for Sweeps 1 & 2

%% -------- TX --------
bits      = binary_data_gen(signal_length);     % 0/1
s_nrz     = modulator(M, bits);                 % ±1, length = signal_length*M
pn        = pn_sequence_lfsr(signal_length, M, init, taps);  % ±1, same length
tx_dsss   = s_nrz .* pn;                        % DSSS signal

N = numel(tx_dsss);
n = 0:N-1;

%% -------- CHANNEL: uniform noise + sinusoid --------
a  = sqrt(3*Pn);                                 % so that Pn = a^2/3
w  = (2*rand(size(tx_dsss)) - 1) * a;            % uniform in [-a, a]
tone = A * sin(w0 * n);                          % narrowband interferer
rx  = tx_dsss + w + tone;                        % received

%% -------- RX: despread, integrate-and-dump, decide --------
despread = rx .* pn;

demod_dsss    = sum( reshape( pad_to_multM(despread, M), M, [] ).', 2 ).'; % 1×Nbits
bits_hat_dsss = demod_dsss >= 0;

% BER with DSSS
err_dsss = sum(bits_hat_dsss ~= bits);
BER_dsss = err_dsss/numel(bits);

%% -------- Baseline (no PN) for comparison --------
rx_noPN      = s_nrz + w + tone;
demod_noPN   = sum( reshape( pad_to_multM(rx_noPN, M), M, [] ).', 2 ).';
bits_hat_noPN= demod_noPN >= 0;
err_noPN     = sum(bits_hat_noPN ~= bits);
BER_noPN     = err_noPN/numel(bits);

fprintf('DSSS demo: errors=%d  BER=%.3g | No PN: errors=%d  BER=%.3g\n', ...
        err_dsss, BER_dsss, err_noPN, BER_noPN);

%% -------- Plots (compact) --------
xBits  = 0:signal_length; 
yBits  = [bits, bits(end)];
figure; subplot(3,3,1); stairs(xBits, yBits, 'LineWidth',1); grid on;
title('Input Binary'); xlabel('Bit index'); ylabel('0/1');

xSamp  = 0:numel(s_nrz);
subplot(3,3,2); stairs(xSamp, [s_nrz s_nrz(end)], 'LineWidth',1); grid on;
title('NRZ (M repeats)'); xlabel('Sample'); ylabel('±1');

subplot(3,3,3);
stairs(xSamp, [pn pn(end)], 'LineWidth',1); grid on;
title('PN chips (±1)'); xlabel('Sample'); ylabel('±1');

subplot(3,3,4);
stairs(xSamp(1:101), [pn(1:100) pn(100)], 'LineWidth',1); grid on;
title('PN chips (±1) - First 100 samples'); xlabel('Sample'); ylabel('±1');

subplot(3,3,5); stairs(xSamp, [tx_dsss tx_dsss(end)], 'LineWidth',1); grid on;
title('DSSS = NRZ ⊙ PN'); xlabel('Sample'); ylabel('±1');

subplot(3,3,6); stairs(xSamp(1:101), [tx_dsss(1:100) tx_dsss(100)], 'LineWidth',1); grid on;
title('DSSS = NRZ ⊙ PN (first 100)'); xlabel('Sample'); ylabel('±1');

subplot(3,3,7); plot(0:numel(rx)-1, rx, 'LineWidth',1); grid on;
title('Channel: DSSS + uniform noise + tone'); xlabel('Sample'); ylabel('amp');

subplot(3,3,8); plot(0:1999, rx(1:2000), 'LineWidth',1); grid on;
title('Channel (first 2000 samples)'); xlabel('Sample'); ylabel('amp');

K = min(2000, N);
subplot(3,3,9);
plot(0:K-1, tone(1:K), 'LineWidth',1); grid on;
title('Interferer (first K samples)'); xlabel('Sample'); ylabel('Amplitude');
finish_fig('Time-domain panels (3x3)');

figure; plot(0:numel(despread)-1, despread, 'LineWidth',1); grid on;
title('After Despread (rx ⊙ PN)'); xlabel('Sample'); ylabel('amp');
finish_fig('Despread samples');

figure; stairs(xBits, [bits_hat_dsss, bits_hat_dsss(end)]*2-1, 'LineWidth',1); grid on;
title(sprintf('Recovered NRZ (DSSS): errors=%d', err_dsss));
xlabel('Bit index'); ylabel('±1');
finish_fig('Recovered NRZ');

%% -------- Spectrum demo: NRZ vs DSSS (current M) --------
Nfft = 2^nextpow2(min(262144, numel(s_nrz)));
[wNRZ_dB, fN]   = mag_spectrum_dB(s_nrz, Nfft);
[wDSSS_dB, fN2] = mag_spectrum_dB(tx_dsss, Nfft);

figure;
