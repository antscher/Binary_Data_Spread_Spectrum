plot(fN, wNRZ_dB, 'LineWidth',1); hold on;
plot(fN2, wDSSS_dB, 'LineWidth',1);
grid on; xlabel('Normalized frequency (cycles/sample)');
ylabel('Magnitude (dB, normalized)');
title(sprintf('Spectrum: NRZ vs DSSS (M = %d chips/bit)', M));
legend('NRZ (no PN)', 'DSSS (NRZ × PN)', 'Location', 'southwest');

subplot(2,1,2);
plot(fN, wNRZ_dB, 'LineWidth',1); hold on;
plot(fN2, wDSSS_dB, 'LineWidth',1);
grid on; xlabel('Normalized frequency (cycles/sample)');
ylabel('Magnitude (dB, normalized)');
title('Zoom near DC (NRZ narrow vs DSSS flat)');
xlim([-0.10 0.10]);
legend('NRZ (no PN)', 'DSSS', 'Location', 'southwest');
finish_fig('Spectrum: NRZ vs DSSS');

%% -------- Effect of M: small vs large M --------
Ms_demo = [50, 1000];
colors  = lines(numel(Ms_demo));
figure;
for i = 1:numel(Ms_demo)
    Mi   = Ms_demo(i);
    s0   = modulator(Mi, bits);
    pn0  = pn_sequence_lfsr(numel(bits), Mi, init, taps);
