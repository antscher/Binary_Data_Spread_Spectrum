%% ====== FUNCTIONS ======
function binary_signal = binary_data_gen(signal_length)
    binary_signal = randi([0, 1],1, signal_length);
end

function mod_signal = modulator(M, binary_signal)
    mod_signal = repelem(2*binary_signal - 1, M);
end

% Pad a row vector with zeros to make its length a multiple of M.
function y = pad_to_multM(x, M)
    L = numel(x); remL = mod(L, M);
    if remL == 0, y = x; else, y = [x, zeros(1, M - remL)]; end
end

function pn = pn_sequence_lfsr(num_bits, chips_per_bit, init, taps)
    if all(init == 0), error('init state must be nonzero.');
    end
    N = num_bits * chips_per_bit;
    reg = logical(init(:).'); chips01 = false(1, N);
    for k = 1:N
        chips01(k) = reg(end);                 % output = rightmost stage
        fb = mod(sum(reg(taps)), 2);           % XOR of taps
        reg = [logical(fb) reg(1:end-1)];      % shift in feedback on left
    end
    pn = 2*double(chips01) - 1;                % map {0,1} -> {-1,+1}
end

function [BER_dsss, BER_noPN] = run_one(Nbits, M, Pn, A, w0, init, taps)
    % bits & NRZ
    bits  = randi([0 1], 1, Nbits);
    s_nrz = repelem(2*bits-1, M);

    % PN & spreading
    pn  = pn_sequence_lfsr(Nbits, M, init, taps);
    tx  = s_nrz .* pn;

    % channel: uniform noise + sinusoid with random phase (per packet)
    a    = sqrt(3*Pn);
    w    = (2*rand(size(tx)) - 1) * a;
    n    = 0:numel(tx)-1;
    phi  = 2*pi*rand;
    tone = A * sin(w0*n + phi);
    rx   = tx + w + tone;

    % despread + integrate & dump
    despread  = rx .* pn;
    y_dsss    = sum(reshape(pad_to_multM(despread, M), M, []).', 2).';
    bhat_dsss = (y_dsss >= 0);
    BER_dsss  = mean(bhat_dsss ~= bits);

    % baseline: no PN
    rx0   = s_nrz + w + tone;
    y0    = sum(reshape(pad_to_multM(rx0, M), M, []).', 2).';
    bhat0 = (y0 >= 0);
    BER_noPN = mean(bhat0 ~= bits);
end

function [BERd_avg, BER0_avg] = run_one_avg(Nbits, M, Pn, A, init, taps, Nfreq)
    BERd = 0; BER0 = 0;
    for r = 1:Nfreq
        % tone frequency drawn in ~[π/M, 2π/M]
        w0 = (2*pi/M) * (0.5 + 0.5*rand);
        [bd, b0] = run_one(Nbits, M, Pn, A, w0, init, taps);
        BERd = BERd + bd;  BER0 = BER0 + b0;
    end
    BERd_avg = BERd / Nfreq;  BER0_avg = BER0 / Nfreq;
end

%% ----- Windowed magnitude spectrum (dB, normalized) -----
function [W_dB, f_norm] = mag_spectrum_dB(x, Nfft)
    x = x(:);
    N = numel(x);
    w = hann(N, 'periodic');
    X = fft(x .* w, Nfft);
    mag = abs(fftshift(X));
    mag = mag / max(mag + eps);
    W_dB = 20*log10(mag + eps);
    f_norm = ((-Nfft/2):(Nfft/2-1))' / Nfft;
end

%% ----- Smooth BER with tone: randomize jammer phase PER BIT -----
function BER = ber_dsss_tone_avg_smooth(M, Pn, A, w0, L, Ntrials, init, taps)
    % Precompute PN once for this (L,M)
    pn = pn_sequence_lfsr(L, M, init, taps);
    a  = sqrt(3*Pn);      % uniform-noise scale so Pn = a^2/3
    total_err = 0;

    for t = 1:Ntrials
        % Bits & NRZ (chips)
        bits = randi([0 1], 1, L);
        s    = repelem(2*bits-1, M);
        tx   = s .* pn;

        % ----- Jammer: sinusoid with RANDOM PHASE PER BIT -----
        % This de-coheres the tone to avoid jagged swings.
        Nchips = numel(tx);
        tone   = zeros(1, Nchips);
        for b = 0:L-1
            idx = b*M + (0:(M-1));
            phi = 2*pi*rand;                      % new phase every bit
            tone(idx+1) = A * sin(w0*(idx) + phi);
        end

        % Channel
        wv  = (2*rand(1, Nchips) - 1) * a;
        rx  = tx + wv + tone;

        % Despread & integrate
        de  = rx .* pn;
        dep = [de, zeros(1, mod(-numel(de), M))];
        y   = sum(reshape(dep, M, []).', 2).';

        % Detect & accumulate errors
        bh  = (y >= 0);
        total_err = total_err + sum(bh ~= bits);
    end

    BER = total_err / (L*Ntrials);
end

%% ----- Figure flush helper -----
function finish_fig(tag)
    drawnow('limitrate'); shg;
    try fnum = gcf().Number; catch, fnum = NaN; end
    fprintf('[%s] Figure "%s" rendered (Fig# %g)\n', ...
            datestr(now,'HH:MM:SS'), tag, fnum);
end
